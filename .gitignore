# ===========================================
# Chinese Name Generator - Root .gitignore
# ===========================================

# --- Frontend (Next.js) ---
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
/frontend!.yarn/patches
/frontend!.yarn/plugins
/frontend!.yarn/releases
/frontend!.yarn/versions
/frontend/coverage/
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts
/frontend/.vercel

# --- Backend (Python) ---
/backend/__pycache__/
/backend/*.py[cod]
/backend/*$py.class
/backend/.venv/
/backend/venv/
/backend/ENV/
/backend/.env
/backend/.env.local
/backend/db.sqlite3
/backend/*.db
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/htmlcov/
/backend/*.egg-info/
/backend/dist/
/backend/build/
/backend/stripe_credentials.json

# --- Project-wide ---
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
