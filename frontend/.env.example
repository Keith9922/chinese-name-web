# --- Anthropic / MiniMax (required for /api/generate-name) ---
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2

# --- Stripe (optional — leave blank for mock mode that returns a fake success URL) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Site URL (used for Stripe success/cancel URLs and OG metadata) ---
# In Vercel set this to your deployed URL (e.g. https://ink-name.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Feedback → Lark / Feishu (optional) ---
# Option A (simplest, recommended): a Custom Bot in any Lark group chat.
#   Create one in Settings → Bots → Custom Bot, then paste the webhook URL here.
#   Every feedback submission becomes a message in that group.
LARK_WEBHOOK_URL=

# Option B (advanced): also write a row to a Lark Bitable so you can browse history.
#   Requires a self-built app (App ID/Secret) with bitable:app permission, plus
#   the App Token + Table ID of your Bitable. Fields expected: Rating, Comment,
#   Chinese Name, Source, Timestamp.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BITABLE_APP_TOKEN=
LARK_BITABLE_TABLE_ID=
